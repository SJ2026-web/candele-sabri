---
import Icon from './Icon.astro';
import { type Prodotto, urlProdotto, formatPrezzo, nomeCreatrice, categoriaById } from '../lib/site';
interface Props { p: Prodotto }
const { p } = Astro.props;
const foto = p.foto[0];
const cat = categoriaById(p.categoria)!;
---
<a href={urlProdotto(p)} class="card reveal">
  <div class="card__img">
    {foto ? (
      <img src={foto.immagine} alt={foto.alt || `${cat.singolare} ${p.nome}`} loading="lazy" decoding="async" width="600" height="600" />
    ) : (
      <div class="card__ph"><Icon name={p.categoria} /><span>Foto in arrivo</span></div>
    )}
  </div>
  <div class="card__body">
    <p class="card__cat">{cat.singolare}{p.bozza && <span class="card__draft">Bozza</span>}</p>
    <h3>{p.nome}</h3>
    {p.profumazione && p.profumazione !== p.nome && <p class="card__scent">{p.profumazione}</p>}
    <div class="card__meta">
      <span class="card__price">{formatPrezzo(p.prezzo)}</span>
      <span class:list={['card__av', !p.disponibile && 'is-off']}>{p.disponibile ? 'Disponibile' : 'Non disponibile'}</span>
    </div>
    <p class="card__by">di {nomeCreatrice(p.creatrice)}</p>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; background: var(--bianco); border-radius: var(--r); overflow: hidden; text-decoration: none; color: inherit; border: 1px solid var(--linea); transition: box-shadow 0.35s, transform 0.35s; }
  .card:hover { box-shadow: var(--ombra); transform: translateY(-3px); color: inherit; }
  .card__img { aspect-ratio: 1; background: #f4ede6; overflow: hidden; }
  .card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
  .card:hover .card__img img { transform: scale(1.035); }
  .card__ph { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem; color: var(--rosa); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .card__ph :global(svg) { width: 64px; height: 64px; opacity: 0.8; }
  .card__body { padding: 1.1rem 1.2rem 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .card__cat { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rosa); margin: 0 0 0.3rem; display: flex; gap: 0.5rem; align-items: center; }
  .card__draft { background: #f3e3c9; color: #7a5a22; border-radius: 99px; padding: 0.05rem 0.55rem; letter-spacing: 0.1em; }
  .card h3 { font-size: 1.45rem; margin: 0 0 0.15rem; }
  .card__scent { font-size: 0.9rem; color: var(--testo); margin: 0 0 0.5rem; font-style: italic; }
  .card__meta { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-top: auto; padding-top: 0.6rem; border-top: 1px solid var(--linea); }
  .card__price { font-weight: 500; color: var(--inchiostro); font-size: 0.98rem; }
  .card__av { font-size: 0.78rem; color: var(--salvia-scuro); display: inline-flex; align-items: center; gap: 0.35rem; }
  .card__av::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--salvia); }
  .card__av.is-off { color: #9a8a90; }
  .card__av.is-off::before { background: #cfc4c7; }
  .card__by { font-size: 0.8rem; color: #8d7b83; margin: 0.45rem 0 0; }
</style>
