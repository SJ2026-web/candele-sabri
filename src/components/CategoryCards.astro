---
import Icon from './Icon.astro';
import { categorie, prodottiDi } from '../lib/site';
---
<div class="cats">
  {categorie.map((c) => {
    const n = prodottiDi(c.id).length;
    return (
      <a href={`/${c.slug}/`} class="cat reveal">
        <div class="cat__img">
          {c.immagine ? <img src={c.immagine} alt={c.titolo} loading="lazy" width="600" height="750" /> : <Icon name={c.id} />}
        </div>
        <div class="cat__body">
          <h3>{c.titolo}</h3>
          <span class="cat__n">{n ? `${n} ${n === 1 ? 'creazione' : 'creazioni'}` : 'In arrivo'}</span>
        </div>
      </a>
    );
  })}
</div>

<style>
  .cats { display: grid; gap: 1.25rem; grid-template-columns: repeat(4, 1fr); }
  .cat { text-decoration: none; color: inherit; display: flex; flex-direction: column; border-radius: var(--r); overflow: hidden; background: var(--bianco); border: 1px solid var(--linea); transition: box-shadow 0.35s, transform 0.35s; }
  .cat:hover { box-shadow: var(--ombra); transform: translateY(-3px); color: inherit; }
  .cat__img { aspect-ratio: 4 / 5; display: grid; place-items: center; background: linear-gradient(180deg, #f8efea 0%, #f4ece4 100%); color: var(--malva); overflow: hidden; }
  .cat__img :global(svg) { width: 34%; height: auto; opacity: 0.85; transition: transform 0.6s ease; }
  .cat:hover .cat__img :global(svg) { transform: scale(1.06) rotate(-2deg); }
  .cat__img img { width: 100%; height: 100%; object-fit: cover; }
  .cat__body { padding: 1rem 1.1rem 1.15rem; text-align: center; }
  .cat h3 { font-size: 1.35rem; margin: 0 0 0.15rem; }
  .cat__n { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rosa); }
  @media (max-width: 900px) { .cats { grid-template-columns: repeat(2, 1fr); gap: 0.9rem; } .cat h3 { font-size: 1.15rem; } }
</style>
