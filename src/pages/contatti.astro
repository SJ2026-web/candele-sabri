---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import c from '../content/pagine/contatti.json';
import { settings, instagramUrl, type CreatriceId } from '../lib/site';
const creatrici: CreatriceId[] = ['sabrina', 'daniela'];
---
<Base title={c.seoTitle} description={c.seoDescription}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: c.titolo }]} />
  <PageHead eyebrow="Scrivici" title={c.titolo} intro={c.intro} />
  <section class="wrap contacts">
    {creatrici.map((id) => (
      <div class="ccard reveal">
        <p class="eyebrow">Creatrice</p>
        <h2>{settings.creatrici[id].nome}</h2>
        <WhatsAppButton creatrice={id} testo={settings.messaggioContatto} label={`WhatsApp ${settings.creatrici[id].nome}`} />
      </div>
    ))}
  </section>
  <section class="narrow more">
    <p>{c.nota}</p>
    {instagramUrl && <p><a class="ig" href={instagramUrl} target="_blank" rel="noopener"><Icon name="instagram" />Instagram @{settings.instagram}</a></p>}
    {settings.email && <p>Email: <a href={`mailto:${settings.email}`}>{settings.email}</a></p>}
    <p class="small">{settings.nomeMarchio} · {settings.regione}</p>
  </section>
</Base>
<style>
  .contacts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.4rem; max-width: 820px; }
  .ccard { background: var(--bianco); border: 1px solid var(--linea); border-radius: var(--r); padding: 2rem 1.5rem; text-align: center; }
  .ccard h2 { font-size: 2.1rem; margin-bottom: 1.1rem; }
  .more { text-align: center; padding: 2.5rem 0 5rem; }
  .ig { display: inline-flex; gap: 0.5rem; align-items: center; }
  .ig :global(svg) { width: 20px; height: 20px; }
  .small { font-size: 0.85rem; color: #8d7b83; }
</style>
